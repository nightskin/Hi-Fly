
#pragma kernel Main
#include "MarchingTable.hlsl"

RWStructuredBuffer<float> weights;

int style;
float isoLevel;
int3 chunkSize;

struct Triangle 
{
    float3 a, b, c;
};

AppendStructuredBuffer<Triangle> triangles;

int indexFromCoord(int x, int y, int z)
{
    return (z * chunkSize.x * chunkSize.y) + (y * chunkSize.x) + x;
}

float3 interp(float3 edgeVertex1, float valueAtVertex1, float3 edgeVertex2, float valueAtVertex2)
{
    return (edgeVertex1 + (isoLevel - valueAtVertex1) * (edgeVertex2 - edgeVertex1)  / (valueAtVertex2 - valueAtVertex1));
}

float3 midPoint(float3 edgeVertex1, float3 edgeVertex2)
{
    return (edgeVertex1 + edgeVertex2) / 2;
}


[numthreads(8,8,8)]
void Main (uint3 id : SV_DispatchThreadID)
{
    if(style == 0)
    {
        if(weights[indexFromCoord(id.x, id.y, id.z)] <= isoLevel) return;
        else
        {
            if(id.z < chunkSize.z - 1)
            {
                if(weights[indexFromCoord(id.x, id.y, id.z + 1)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;
                    t1.a = float3(0,1,1) + id;
                    t1.b = float3(1,1,1) + id;
                    t1.c = float3(1,0,1) + id;
                    t2.a = float3(0,0,1) + id;
                    t2.b = float3(0,1,1) + id;
                    t2.c = float3(1,0,1) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }
            if(id.z > 0)
            {
                if(weights[indexFromCoord(id.x, id.y, id.z - 1)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;
                    t1.a = float3(1,0,0) + id;
                    t1.b = float3(1,1,0) + id;
                    t1.c = float3(0,1,0) + id;
                    t2.a = float3(1,0,0) + id;
                    t2.b = float3(0,1,0) + id;
                    t2.c = float3(0,0,0) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }

            if(id.y < chunkSize.y - 1)
            {
                if(weights[indexFromCoord(id.x, id.y + 1, id.z)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;
                    t1.a = float3(1,1,0) + id;
                    t1.b = float3(1,1,1) + id;
                    t1.c = float3(0,1,1) + id;
                    t2.a = float3(1,1,0) + id;
                    t2.b = float3(0,1,1) + id;
                    t2.c = float3(0,1,0) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }
            if(id.y > 0)
            {
                if(weights[indexFromCoord(id.x, id.y - 1, id.z)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;
                    
                    t1.a = float3(0,0,1) + id;
                    t1.b = float3(1,0,1) + id;
                    t1.c = float3(1,0,0) + id;
                    t2.a = float3(0,0,0) + id;
                    t2.b = float3(0,0,1) + id;
                    t2.c = float3(1,0,0) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }
            
            if(id.x < chunkSize.x - 1)
            {
                if(weights[indexFromCoord(id.x + 1, id.y, id.z)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;

                    t1.a = float3(1,0,1) + id;
                    t1.b = float3(1,1,1) + id;
                    t1.c = float3(1,1,0) + id;
                    t2.a = float3(1,0,1) + id;
                    t2.b = float3(1,1,0) + id;
                    t2.c = float3(1,0,0) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }
            if(id.x > 0)
            {
                if(weights[indexFromCoord(id.x - 1, id.y, id.z)] <= isoLevel)
                {
                    Triangle t1;
                    Triangle t2;
                    
                    t1.a = float3(0,1,0) + id;
                    t1.b = float3(0,1,1) + id;
                    t1.c = float3(0,0,1) + id;
                    t2.a = float3(0,0,0) + id;
                    t2.b = float3(0,1,0) + id;
                    t2.c = float3(0,0,1) + id;

                    triangles.Append(t1);
                    triangles.Append(t2);
                }
            }
        }

    }
    else
    {
        if (id.x >= chunkSize.x - 1 || id.y >= chunkSize.y - 1 || id.z >= chunkSize.z - 1)
        {
            return;
        }

        float cubeValues[8] = 
        {
           weights[indexFromCoord(id.x, id.y, id.z + 1)],
           weights[indexFromCoord(id.x + 1, id.y, id.z + 1)],
           weights[indexFromCoord(id.x + 1, id.y, id.z)],
           weights[indexFromCoord(id.x, id.y, id.z)],
           weights[indexFromCoord(id.x, id.y + 1, id.z + 1)],
           weights[indexFromCoord(id.x + 1, id.y + 1, id.z + 1)],
           weights[indexFromCoord(id.x + 1, id.y + 1, id.z)],
           weights[indexFromCoord(id.x, id.y + 1, id.z)]
        };

        int cubeIndex = 0;
        if (cubeValues[0] > isoLevel) cubeIndex |= 1;
        if (cubeValues[1] > isoLevel) cubeIndex |= 2;
        if (cubeValues[2] > isoLevel) cubeIndex |= 4;
        if (cubeValues[3] > isoLevel) cubeIndex |= 8;
        if (cubeValues[4] > isoLevel) cubeIndex |= 16;
        if (cubeValues[5] > isoLevel) cubeIndex |= 32;
        if (cubeValues[6] > isoLevel) cubeIndex |= 64;
        if (cubeValues[7] > isoLevel) cubeIndex |= 128;

        int edges[] = triTable[cubeIndex];

        for (int i = 0; edges[i] != -1; i += 3)
        {
            // First edge lies between vertex e00 and vertex e01
            int e00 = edgeConnections[edges[i]][0];
            int e01 = edgeConnections[edges[i]][1];

            // Second edge lies between vertex e10 and vertex e11
            int e10 = edgeConnections[edges[i + 1]][0];
            int e11 = edgeConnections[edges[i + 1]][1];

            // Third edge lies between vertex e20 and vertex e21
            int e20 = edgeConnections[edges[i + 2]][0];
            int e21 = edgeConnections[edges[i + 2]][1];

            Triangle tri;
            if(style == 1)
            {
                tri.a = midPoint(cornerOffsets[e00], cornerOffsets[e01]) + id;
                tri.b = midPoint(cornerOffsets[e10], cornerOffsets[e11]) + id;
                tri.c = midPoint(cornerOffsets[e20], cornerOffsets[e21]) + id;

            }
            else if(style == 2)
            {
                tri.a = interp(cornerOffsets[e00], cubeValues[e00], cornerOffsets[e01], cubeValues[e01]) + id;
                tri.b = interp(cornerOffsets[e10], cubeValues[e10], cornerOffsets[e11], cubeValues[e11]) + id;
                tri.c = interp(cornerOffsets[e20], cubeValues[e20], cornerOffsets[e21], cubeValues[e21]) + id;
            }

            triangles.Append(tri);
        }
    }

    

    

}
